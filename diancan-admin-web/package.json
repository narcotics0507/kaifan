{
  "name": "diancan-admin-web",
  "type": "module",
  "version": "1.0.0",
  "description": "点餐管理系统管理端，基于Vue3、Vite、TypeScript、NaiveUI和UnoCSS",
  "author": {
    "name": "Henfon"
  },
  "license": "MIT",
  "keywords": [
    "Vue3 admin",
    "vue-admin-template",
    "Vite",
    "TypeScript",
    "naive-ui"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "gen-route": "sa gen-route",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.0",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@stomp/stompjs": "^7.3.0",
    "@vueuse/core": "14.1.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.19",
    "defu": "6.1.4",
    "echarts": "6.0.0",
    "json5": "2.2.3",
    "naive-ui": "2.43.2",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "3.4.0",
    "vue": "3.5.27",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.430",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config": "1.7.5",
    "@types/node": "25.0.9",
    "@types/nprogress": "0.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@unocss/eslint-config": "66.6.0",
    "@unocss/preset-icons": "66.6.0",
    "@unocss/preset-uno": "66.6.0",
    "@unocss/transformer-directives": "66.6.0",
    "@unocss/transformer-variant-group": "66.6.0",
    "@unocss/vite": "66.6.0",
    "@vitejs/plugin-vue": "6.0.3",
    "@vitejs/plugin-vue-jsx": "5.1.3",
    "consola": "3.4.2",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.7.0",
    "kolorist": "1.8.0",
    "sass": "1.97.2",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "31.0.0",
    "vite": "7.3.1",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.0.5",
    "vite-plugin-vue-transition-root-validator": "^0.0.4",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm --dir diancan-admin-web sa git-commit-verify",
    "pre-commit": "pnpm --dir diancan-admin-web typecheck"
  }
}
